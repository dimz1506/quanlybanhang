@model MymvcApp.Models.Category
@{
    ViewData["Title"] = "Category Details";
}
<form asp-action="details" method="get">
         <div class="form-group">
                  <label asp-for="@Model.Id" class="control-label">Category ID</label>
                  <input asp-for="@Model.Id" class="form-control" readonly />
                  <span asp-validation-for="@Model.Id" class="text-danger"></span>
         </div>
         <div class="form-group">
                  <label asp-for="@Model.Name" class="control-label">Category Name</label>
                  <input asp-for="@Model.Name" class="form-control" readonly />
                  <span asp-validation-for="@Model.Name" class="text-danger"></span>
         </div>
         <div class="form-group">
                  <label asp-for="@Model.Description" class="control-label">Category Description</label>
                  <input asp-for="@Model.Description" class="form-control" readonly />
                  <span asp-validation-for="@Model.Description" class="text-danger"></span>
         </div>
         <div class="form-group">
                  <label asp-for="@Model.CreatedAt" class="control-label">Created At</label>
                  <input asp-for="@Model.CreatedAt" class="form-control" readonly />
                  <span asp-validation-for="@Model.CreatedAt" class="text-danger"></span>
         </div>
         <div class="form-group">
                  <a asp-action="Index" class="btn btn-secondary">Back to List</a>
         </div>

</form>