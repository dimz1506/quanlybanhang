@model List<MymvcApp.Models.Product>
@{
    ViewData["Title"] = "Product List";
}
<style>
    body{
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
    }
    .product-grid{
        
         display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); /* mỗi ô min 250px, tự xuống dòng */
    gap: 20px;
    margin-top: 20px;
    }
    .product-card:hover{
        transform: translateY(-5px);
    }
    .product-image img{
        width: 100px; /* kich thuong vuong*/
        aspect-ratio: 1 / 1; /* ti le khung hinh */
        object-fit: cover; /* cat hinh cho dep */
        border-radius: 5px; /* bo tron nhe*/
    }
    .product-infor{
        padding: 10px;
    }
    .product-name{
        font-size: 15px;
        font-weight: bold;
        color: #333;
        height: 40px;
        overflow: hidden;
    }
    .product-price{
        color: #ee4d2d;
        font-size: 18px;
        margin: 5px; 0
    }
    .product-id{
        color: #9875;
        font-size: 18px;
        margin: 5px; 0
    }
    .product-rating{
        font-size: 14px;
        color: #666;
    }
    .product-rating span{
        font-size: 12px;
        color: #666;
        margin-left: 5px; 
    }
</style>
<h2> Danh sach san pham</h2>
@* @if(User.IsInRole("Admin")){
    <a asp-action="Create" class="btn btn-success mb-3">Create New Product</a>
} *@
@* <form method="Get" asp-controller="Product" asp-action="Index">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search by name" class="form-control mb-3" />
    <button type="submit" class="btn btn-primary">Search</button>
</form> *@
 
 <p>
    <a asp-action="Create" class="btn btn-success mb-3">Create New Product</a>
</p>

    <div class = "product-grid">
        @foreach (var item in Model)
        {
                <div class="product-card">
                <div class="product-image">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" width="100" />
                    }
                </div>
                
                <div class="product-infor">
                    <div class="product-id">
                    <label style="font-weight: bold;">ProductID:</label>
                    @item.Id
                    </div>
                    <div clas="product-name">
                    <label style="font-weight: bold;">Product Name:</label>
                    @item.Name
                    </div>
                    <div clas="product-price">
                    <label style="font-weight: bold;">Price:</label>
                    @item.Price.ToString("C")
                    </div>
                    <div class="product-name">
                    <label style="font-weight: bold;">Category:</label>
                    @item.Category?.Name
                    </div>
                    <div class="product-name">
                    <label style="font-weight: bold;">CategoryID:</label>
                    @item.CategoryId
                    </div>
                    <div class="product-name"> 
                    <label style="font-weight: bold;">Description:</label>
                    @item.Description
                    </div>
                    <div class="product-name">
                    <label style="font-weight: bold;">Created At:</label>
                    @item.CreatedAt.ToString("g")
                    </div>
                
                </div>
                <div style="margin: 10px 0;">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                @* @if(User.IsInRole("Admin")){ *@
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
              @* } *@
                </div>
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <button type="submit" class="btn btn-primary">Add to Cart</button>
                </form>
            </div>
        }
        </div>

